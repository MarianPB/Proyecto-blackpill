(version 1)
(rule "Una sola capa: sin zonas arriba" (layer "F.Cu") (constraint disallow zone))
(rule "Puentes de alambre: pista arriba de 0,8 mm" (layer "F.Cu") (constraint track_width (min 0.8mm)))
(rule "Alimentacion y masas: 1,27 mm" (layer "B.Cu") (condition "A.NetClass == 'Alim_5V' || A.NetClass == 'Alim_3V3' || A.NetClass == 'Masas'") (constraint track_width (min 1.0mm) (opt 1.27mm)))
